{
  "name": "@wordhunt/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "words:info": "node -e \"const fs=require('fs'); const p='data/wordlist-meta.json'; console.log(fs.existsSync(p) ? fs.readFileSync(p,'utf8') : 'Full word list not installed. Run npm run words:setup from repo root.')\""
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@wordhunt/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "jose": "^5.9.0",
    "prisma": "^6.0.0",
    "socket.io": "^4.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
